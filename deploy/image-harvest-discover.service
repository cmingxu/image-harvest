[Unit]
Description=image-harvest domain discovery (probe top-1M list, keep reachable candidates)
Documentation=https://github.com/cmingxu/image-harvest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/config.env
# probes the top-1M list and stores only the reachable sites in DuckDB;
# results are written in small batches, so the dashboard keeps serving.
# The offset rotates by day, so repeated daily runs walk through the list.
ExecStart=/bin/sh -c 'off=$(( ( $(date +%j) * ${DISCOVER_LIMIT:-2000} + ${DISCOVER_OFFSET:-0} ) % 999000 )); exec __APP_DIR__/bin/image-harvest -discover \
  -db __APP_DIR__/data/harvest.duckdb \
  -list "${LIST:-https://s3-us-west-1.amazonaws.com/umbrella-static/top-1m.csv.zip}" \
  -list-cache __APP_DIR__/data/top-1m.csv \
  -discover-limit "${DISCOVER_LIMIT:-2000}" \
  -discover-offset "$off" \
  -discover-timeout "${PROBE_TIMEOUT:-4s}" \
  -workers "${WORKERS:-4}"'
Nice=10
StandardOutput=append:__APP_DIR__/logs/discover.log
StandardError=append:__APP_DIR__/logs/discover.log

[Install]
WantedBy=default.target
