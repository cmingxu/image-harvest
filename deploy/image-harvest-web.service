[Unit]
Description=image-harvest web dashboard (DuckDB + media)
Documentation=https://github.com/cmingxu/image-harvest
After=network-online.target
Wants=network-online.target
# the media root lives on the NAS: never start without it, or writes would
# silently land on the local disk instead
RequiresMountsFor=__MOUNT_DIR__
ConditionPathIsDirectory=__OUT_DIR__

[Service]
Type=simple
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/config.env
# refuse to run if the media root is not really on a network filesystem
ExecStartPre=/bin/sh -c 'fs=$(findmnt -n -o FSTYPE -T __OUT_DIR__); case "$$fs" in cifs|smb3|nfs|nfs4) exit 0;; *) echo "refusing to start: __OUT_DIR__ is on local fs ($$fs), NAS not mounted"; exit 1;; esac'
ExecStart=__APP_DIR__/bin/harvest-web -addr __ADDR__ -db __APP_DIR__/data/harvest.duckdb -out __OUT_DIR__
Environment=GIN_MODE=release
Restart=on-failure
RestartSec=3
StandardOutput=append:__APP_DIR__/logs/harvest-web.log
StandardError=append:__APP_DIR__/logs/harvest-web.log

# hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__APP_DIR__/data __APP_DIR__/logs __OUT_DIR__

[Install]
WantedBy=default.target
