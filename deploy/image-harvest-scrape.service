[Unit]
Description=image-harvest image scraping (imported domains, 1 req/s, 10s between domains)
Documentation=https://github.com/cmingxu/image-harvest
After=network-online.target
Wants=network-online.target
# harvested images live on the NAS: never write to the local disk
RequiresMountsFor=__MOUNT_DIR__
ConditionPathIsDirectory=__OUT_DIR__

[Service]
Type=simple
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/config.env
# refuse to run if the media root is not on a network filesystem
ExecStartPre=/bin/sh -c 'fs=$(findmnt -n -o FSTYPE -T __OUT_DIR__); case "$$fs" in cifs|smb3|nfs|nfs4) exit 0;; *) echo "refusing to start: __OUT_DIR__ is on local fs ($$fs), NAS not mounted"; exit 1;; esac'
# -interval paces every request, -domain-interval the gap between domains;
# -min drops anything below the configured resolution before download
ExecStart=/bin/sh -c 'exec __APP_DIR__/bin/image-harvest -crawl-domains -require-netfs \
  -db __APP_DIR__/data/harvest.duckdb \
  -out __OUT_DIR__ \
  -depth "${DEPTH:-2}" -min "${MIN_RES:-1200x800}" -quality "${QUALITY:-92}" \
  -maxpages "${MAX_PAGES:-200}" -workers "${WORKERS:-2}" \
  -interval "${REQUEST_INTERVAL:-1s}" \
  -domain-interval "${DOMAIN_INTERVAL:-10s}" \
  ${CRAWL_LIMIT:+-crawl-limit "$CRAWL_LIMIT"}'
Restart=always
RestartSec=30
Nice=10
StandardOutput=append:__APP_DIR__/logs/scrape.log
StandardError=append:__APP_DIR__/logs/scrape.log

[Install]
WantedBy=default.target
